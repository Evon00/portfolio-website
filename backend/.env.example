# .env로 복사한 뒤 값을 채워서 사용
#########################################################
SPRING_PROFILES_ACTIVE=dev

#########################################################
# DB (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio
DB_USERNAME=root
DB_PASSWORD=

#########################################################
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

#########################################################
# 로그 파일 경로 (prod 전용, 기본값 /var/www/app/logs)
#LOG_PATH=

#########################################################
# JWT (Base64로 인코딩한 64바이트 난수 : openssl rand -base64 64 | tr -d '\r\n')
JWT_SECRET=

#########################################################
# 프론트엔드 주소 (CORS 허용, 기본값 http://localhost:3000)
#FRONTEND_URL=

#########################################################
# AWS S3 (S3_PUBLIC_URL : CloudFront 주소, https:// 포함)
# 운영 서버는 IAM 역할을 사용하므로 AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY는 비워둔다
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_PUBLIC_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
