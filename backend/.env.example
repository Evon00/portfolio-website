# .env로 복사한 뒤 값을 채워서 사용
#########################################################
SPRING_PROFILES_ACTIVE=dev

#########################################################
# DB (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio
DB_USERNAME=root
DB_PASSWORD=

#########################################################
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

#########################################################
# 로그 파일 경로 (prod 전용, 기본값 /var/www/app/logs)
#LOG_PATH=

#########################################################
# JWT (Base64로 인코딩한 64바이트 난수 : openssl rand -base64 64 | tr -d '\r\n')
JWT_SECRET=

#########################################################
# 프론트엔드 주소 (CORS 허용, 기본값 http://localhost:3000)
#FRONTEND_URL=
