# 환경 변수 키 목록. 값은 .env.local(로컬)·Vercel 프로젝트 설정(배포)에 넣는다.

# Spring API 주소 (서버 전용, 6단계)
API_BASE_URL=

# 타입 생성기(sync:api · controller)가 읽는 openapi.json 위치(선택). 비우면 ../backend/openapi/openapi.json
API_SYNC_SPEC_FILE=

# 목 계정 로그인 (5단계 ~ Spring 연결 전)
ADMIN_MOCK_USERNAME=
ADMIN_MOCK_PASSWORD=
# 목 세션 토큰 서명 키. 충분히 긴 무작위 문자열
ADMIN_MOCK_SESSION_SECRET=
